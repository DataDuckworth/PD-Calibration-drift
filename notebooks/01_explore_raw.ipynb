   "source": [
    "# files, size and number of columns\n",
    "rows = []\n",
    "for y in YEARS:\n",
    "    for k in [\"orig\", \"perf\"]:\n",
    "        f = RAW / f\"sample_{k}_{y}.txt\"\n",
    "        # first line is enough to count columns\n",
    "        with open(f, \"r\", encoding=\"latin-1\") as fh:\n",
    "            n_cols = len(fh.readline().rstrip(\"\\n\").split(\"|\"))\n",
    "        rows.append({\"year\": y, \"file\": k, \"size_MB\": round(f.stat().st_size / 1e6), \"columns\": n_cols})\n",
    "# one row per year is easier to compare\n",
    "inventory = pd.DataFrame(rows).pivot(index=\"year\", columns=\"file\", values=[\"size_MB\", \"columns\"])\n",
    "inventory"
