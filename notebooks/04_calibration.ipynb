    "y_fit = {m: get(m, FIT) for m in MODELS}\n",
    "platt_fit, iso_fit = {}, {}\n",
    "for m, (yf, pf) in y_fit.items():\n",
    "    g = sm.GLM(yf, sm.add_constant(logit(pf)), family=sm.families.Binomial()).fit()\n",
    "    platt_fit[m] = (g.params[0], g.params[1])\n",
    "    iso_fit[m] = IsotonicRegression(out_of_bounds=\"clip\").fit(pf, yf)\n",
    "print(\"Platt line fitted on the training years (intercept, slope):\",\n",
    "      {m: tuple(round(v, 3) for v in platt_fit[m]) for m in MODELS})\n",
    "\n",
    "# default rate of each whole loan year (for the \"2 years old\" correction)\n",
    "loans_tbl = pd.read_parquet(ROOT / \"data\" / \"processed\" / \"loans.parquet\", columns=[\"vintage\", \"default_24m\"])\n",
    "rate_by_year = loans_tbl.groupby(\"vintage\")[\"default_24m\"].mean().to_dict()\n",
    "print(\"default rate by loan year:\", {k: round(100 * v, 2) for k, v in rate_by_year.items()})\n",
    "\n",
    "def adjusted(model, s, how):\n",
    "    y, p = get(model, s)\n",
    "    year = None if s == HOLD else int(s)\n",
    "    if how == \"none\":\n",
    "        return y, p\n",
    "    if how == \"Platt (training years)\":\n",
    "        a, b = platt_fit[model]\n",
    "        return y, expit(a + b * logit(p))\n",
    "    if how == \"isotonic (training years)\":\n",
    "        return y, np.clip(iso_fit[model].predict(p), 1e-4, 1 - 1e-4)\n",
    "    if year is None:\n",
    "        return None\n",
    "    if how == \"base rate, 2 years old\":\n",
    "        return y, expit(logit(p) + level_shift(p, rate_by_year[year - 2]))\n",
    "    if how == \"base rate, true (oracle)\":\n",
    "        return y, expit(logit(p) + level_shift(p, y.mean()))\n",
    "    if how == \"Platt on the test year (oracle)\":\n",
    "        g = sm.GLM(y, sm.add_constant(logit(p)), family=sm.families.Binomial()).fit()\n",
    "        return y, expit(g.params[0] + g.params[1] * logit(p))\n",
    "\n",
    "HOWS = [\"none\", \"Platt (training years)\", \"isotonic (training years)\", \"base rate, 2 years old\",\n",
    "        \"base rate, true (oracle)\", \"Platt on the test year (oracle)\"]\n",
    "rows = []\n",
    "for model in MODELS:\n",
    "    for s in TEST:\n",
    "        for how in HOWS:\n",
    "            out = adjusted(model, s, how)\n",
    "            if out is None:\n",
    "                continue\n",
    "            y, p = out\n",
    "            c = calib(y, p)\n",
    "            rows.append({\"model\": model, \"set\": s, \"method\": how, \"predicted / actual\": c[\"predicted / actual\"],\n",
    "                         \"slope\": c[\"slope\"], \"ECE %\": c[\"ECE %\"], \"Brier\": c[\"Brier\"], \"log loss\": c[\"log loss\"]})\n",
    "recal = pd.DataFrame(rows)\n",
    "recal.round(4).to_csv(ROOT / \"results\" / \"tables\" / \"recalibration_results.csv\", index=False)\n",
