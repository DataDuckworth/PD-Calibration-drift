    "def logit(p):\n",
    "    return np.log(p / (1 - p))\n",
    "\n",
    "def expit(z):\n",
    "    return 1 / (1 + np.exp(-z))\n",
    "\n",
    "def level_shift(p, target_rate):\n",
    "    # the number a such that adding it to the log-odds makes the average prediction equal the target rate\n",
    "    return optimize.brentq(lambda a: expit(logit(p) + a).mean() - target_rate, -12, 12)\n",
    "\n",
    "def slope_fit(y, p):\n",
    "    m = sm.GLM(y, sm.add_constant(logit(p)), family=sm.families.Binomial()).fit()\n",
    "    return m.params[0], m.params[1], m.bse[1]\n",
    "\n",
    "def groups(y, p, k=10):\n",
    "    g = pd.qcut(p, k, labels=False, duplicates=\"drop\")\n",
    "    t = pd.DataFrame({\"g\": g, \"y\": y, \"p\": p}).groupby(\"g\").agg(n=(\"y\", \"size\"), obs=(\"y\", \"mean\"), pred=(\"p\", \"mean\"), d=(\"y\", \"sum\"))\n",
    "    return t\n",
    "\n",
    "def calib(y, p):\n",
    "    t = groups(y, p)\n",
    "    N, ybar = len(y), y.mean()\n",
    "    a, b, se = slope_fit(y, p)\n",
    "    z = (y.sum() - p.sum()) / np.sqrt((p * (1 - p)).sum())\n",
    "    return {\"actual %\": 100 * ybar, \"predicted %\": 100 * p.mean(), \"predicted / actual\": p.mean() / ybar,\n",
    "            \"level shift\": level_shift(p, ybar), \"slope\": b, \"slope low\": b - 1.96 * se, \"slope high\": b + 1.96 * se,\n",
    "            \"reliability\": (t.n * (t.pred - t.obs) ** 2).sum() / N, \"resolution\": (t.n * (t.obs - ybar) ** 2).sum() / N,\n",
    "            \"ECE %\": 100 * (t.n * (t.pred - t.obs).abs()).sum() / N, \"binomial test p\": 2 * stats.norm.sf(abs(z)),\n",
    "            \"Brier\": brier_score_loss(y, p), \"log loss\": log_loss(y, p)}\n",
    "\n",
    "rows = []\n",
    "for model in MODELS:\n",
    "    for s in [FIT] + TEST:\n",
    "        y, p = get(model, s)\n",
    "        rows.append({\"model\": model, \"set\": s, **calib(y, p)})\n",
    "cal = pd.DataFrame(rows)\n",
    "cal.drop(columns=[\"Brier\"]).set_index([\"model\", \"set\"]).round(4)"
   ]
