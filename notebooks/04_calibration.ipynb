    "def wilson(d, n, z=1.96):\n",
    "    p = d / n\n",
    "    centre = (p + z * z / (2 * n)) / (1 + z * z / n)\n",
    "    half = z * np.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / (1 + z * z / n)\n",
    "    return centre - half, centre + half\n",
    "\n",
    "fig, axes = plt.subplots(2, 4, figsize=(17, 8.5), sharex=True, sharey=True)\n",
    "for r, model in enumerate(MODELS):\n",
    "    for c, s in enumerate(TEST):\n",
    "        ax = axes[r, c]\n",
    "        y, p = get(model, s)\n",
    "        t = groups(y, p)\n",
    "        lo, hi = wilson(t.d.to_numpy(), t.n.to_numpy())\n",
    "        obs = np.clip(t.obs, 1e-4, None)\n",
    "        ax.errorbar(t.pred, obs, yerr=[np.clip(obs - lo, 0, None), np.clip(hi - obs, 0, None)], fmt=\"o\", color=\"#4C72B0\", capsize=2)\n",
    "        ax.plot([1e-4, 0.3], [1e-4, 0.3], \"k--\", lw=1)\n",
    "        ax.set_xscale(\"log\")\n",
    "        ax.set_yscale(\"log\")\n",
    "        ax.set_xlim(2e-4, 0.3)      # the lowest-risk tenth is predicted at about 0.04%, so the axis must start below that\n",
    "        ax.set_ylim(1e-4, 0.3)\n",
    "        ax.set_title(f\"{model}, {s.split(' (')[0]}\", fontsize=10)\n",
    "        ax.spines[[\"top\", \"right\"]].set_visible(False)\n",
    "for ax in axes[1]:\n",
    "    ax.set_xlabel(\"average predicted default rate\")\n",
    "for ax in axes[:, 0]:\n",
    "    ax.set_ylabel(\"actual default rate\")\n",
    "plt.tight_layout()\n",
    "(ROOT / \"results\" / \"figures\").mkdir(parents=True, exist_ok=True)\n",
    "plt.savefig(ROOT / \"results\" / \"figures\" / \"reliability_diagrams.png\", dpi=130)\n",
    "plt.show()"
   ]
