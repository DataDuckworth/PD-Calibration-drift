    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import statsmodels.api as sm\n",
    "from scipy import optimize, stats\n",
    "from sklearn.isotonic import IsotonicRegression\n",
    "from sklearn.metrics import brier_score_loss, log_loss\n",
    "\n",
    "ROOT = Path.cwd().parent          # this notebook lives in notebooks/\n",
    "pd.set_option(\"display.width\", 170)\n",
    "pd.set_option(\"display.max_columns\", 30)\n",
    "\n",
    "pred = pd.read_parquet(ROOT / \"data\" / \"processed\" / \"predictions.parquet\")\n",
    "FIT = \"2002-04 out-of-fold\"\n",
    "HOLD = \"in-time hold-out (2002-04, 20%)\"\n",
    "TEST = [HOLD, \"2005\", \"2006\", \"2007\"]\n",
    "MODELS = {\"logistic\": \"p_logistic\", \"boosting\": \"p_boosting\"}\n",
    "\n",
    "def get(model, s):\n",
    "    d = pred[pred[\"set\"] == s]\n",
    "    return d[\"y\"].to_numpy(), np.clip(d[MODELS[model]].to_numpy(), 1e-6, 1 - 1e-6)\n",
    "\n",
    "pred.groupby(\"set\").agg(loans=(\"y\", \"size\"), defaults=(\"y\", \"sum\"), actual_rate_pct=(\"y\", lambda s: round(100 * s.mean(), 2)))"
   ]
