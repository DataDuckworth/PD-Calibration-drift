   "source": [
    "y_fit, g_fit = fit[\"default_24m\"].to_numpy(), fit[\"vintage\"].to_numpy()\n",
    "logo = LeaveOneGroupOut()\n",
    "tuning, best = [], {}\n",
    "for name, cols in variants.items():\n",
    "    kind = \"logistic\" if name.startswith(\"logistic\") else \"boosting\"\n",
    "    X = get_X(kind, fit, cols)\n",
    "    scores = []\n",
    "    for params in (LOGIT_GRID if kind == \"logistic\" else GBM_GRID):\n",
    "        ll, auc = [], []\n",
    "        for tr, va in logo.split(X, y_fit, g_fit):\n",
    "            m = clone(build(kind, cols, params)).fit(X.iloc[tr], y_fit[tr])\n",
    "            p = m.predict_proba(X.iloc[va])[:, 1]\n",
    "            ll.append(log_loss(y_fit[va], p))\n",
    "            auc.append(roc_auc_score(y_fit[va], p))\n",
    "        scores.append({\"model\": name, \"settings\": str(params), \"log loss\": np.mean(ll), \"AUC\": np.mean(auc), \"params\": params})\n",
    "    tuning += scores\n",
    "    best[name] = min(scores, key=lambda s: s[\"log loss\"])[\"params\"]\n",
    "tune_tab = pd.DataFrame(tuning)\n",
    "tune_tab[\"chosen\"] = [t[\"params\"] == best[t[\"model\"]] for t in tuning]\n",
    "tune_tab.drop(columns=\"params\").round(4)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b9aedf2b",
