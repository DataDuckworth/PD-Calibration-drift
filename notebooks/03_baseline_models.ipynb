   "source": [
    "# helpers: turn a table into model input, and build a model\n",
    "CATS = {c: sorted(fit[c].dropna().unique()) for c in bmt.CATEGORICAL + [\"state_region\"]}   # categories seen in training\n",
    "\n",
    "def split_cols(cols):\n",
    "    return [c for c in cols if c in NUM_ALL], [c for c in cols if c not in NUM_ALL]\n",
    "\n",
    "def get_X(kind, df, cols):\n",
    "    num, cat = split_cols(cols)\n",
    "    X = df[num + cat].copy()\n",
    "    for c in cat:\n",
    "        # logistic: plain text; boosting: a category type with the categories from the training years\n",
    "        X[c] = X[c].astype(object) if kind == \"logistic\" else pd.Categorical(X[c], categories=CATS[c])\n",
    "    return X\n",
    "\n",
    "def build(kind, cols, params):\n",
    "    num, cat = split_cols(cols)\n",
    "    if kind == \"logistic\":\n",
    "        pre = ColumnTransformer([\n",
    "            (\"num\", Pipeline([(\"fill\", SimpleImputer(strategy=\"median\")), (\"scale\", StandardScaler())]), num),\n",
    "            (\"cat\", Pipeline([(\"fill\", SimpleImputer(strategy=\"constant\", fill_value=\"missing\")),\n",
    "                              (\"onehot\", OneHotEncoder(handle_unknown=\"infrequent_if_exist\", min_frequency=0.01))]), cat)])\n",
    "        return Pipeline([(\"pre\", pre), (\"model\", LogisticRegression(C=params[\"C\"], max_iter=2000))])\n",
    "    return LGBMClassifier(learning_rate=0.03, min_child_samples=200, subsample=0.8, subsample_freq=1,\n",
    "                          colsample_bytree=0.8, reg_lambda=5, random_state=0, verbose=-1, n_jobs=4, **params)\n",
    "\n",
    "LOGIT_GRID = [{\"C\": c} for c in (0.001, 0.01, 0.1, 1, 10)]\n",
    "GBM_GRID = [{\"num_leaves\": nl, \"n_estimators\": ne} for nl in (4, 8) for ne in (200, 500)]"
   ]
  },
