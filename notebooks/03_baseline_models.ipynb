    "fit_all = full[full[\"group\"] == \"train\"]\n",
    "strata = fit_all[\"vintage\"].astype(str) + \"_\" + fit_all[\"default_24m\"].astype(str)\n",
    "fit_idx, hold_idx = train_test_split(fit_all.index, test_size=0.2, random_state=42, stratify=strata)\n",
    "fit, hold = full.loc[fit_idx], full.loc[hold_idx]\n",
    "tests = {\"in-time hold-out (2002-04, 20%)\": hold, \"2005\": full[full[\"vintage\"] == 2005],\n",
    "         \"2006\": full[full[\"vintage\"] == 2006], \"2007\": full[full[\"vintage\"] == 2007]}\n",
    "\n",
    "split = pd.DataFrame({name: {\"loans\": len(d), \"defaults\": int(d[\"default_24m\"].sum()),\n",
    "                             \"default rate %\": round(100 * d[\"default_24m\"].mean(), 2)}\n",
    "                      for name, d in {\"fit set (2002-04, 80%)\": fit, **tests}.items()}).T\n",
    "split"
   ]
