    "const = y_fit.mean()\n",
    "rng = np.random.default_rng(0)\n",
    "\n",
    "def evaluate(y, p, n_boot=200):\n",
    "    y, p = np.asarray(y), np.asarray(p)\n",
    "    row = {\"loans\": len(y), \"defaults\": int(y.sum()), \"actual %\": 100 * y.mean(), \"predicted %\": 100 * p.mean(),\n",
    "           \"predicted / actual\": p.mean() / y.mean(), \"AUC\": roc_auc_score(y, p), \"Brier\": brier_score_loss(y, p),\n",
    "           \"log loss\": log_loss(y, p), \"Brier skill\": 1 - brier_score_loss(y, p) / brier_score_loss(y, np.full(len(y), const))}\n",
    "    auc, ratio = [], []\n",
    "    for _ in range(n_boot):\n",
    "        i = rng.integers(0, len(y), len(y))\n",
    "        if y[i].sum() == 0:\n",
    "            continue\n",
    "        auc.append(roc_auc_score(y[i], p[i]))\n",
    "        ratio.append(p[i].mean() / y[i].mean())\n",
    "    row[\"AUC low\"], row[\"AUC high\"] = np.percentile(auc, [2.5, 97.5])\n",
    "    row[\"ratio low\"], row[\"ratio high\"] = np.percentile(ratio, [2.5, 97.5])\n",
    "    return row\n",
    "\n",
    "ys = {\"2002-04 out-of-fold\": y_fit, **{k: d[\"default_24m\"].to_numpy() for k, d in eval_sets.items()}}\n",
    "rows = []\n",
    "for name in variants:\n",
    "    for sname in ys:\n",
    "        rows.append({\"model\": name, \"test set\": sname, **evaluate(ys[sname], preds[name][sname])})\n",
    "metrics = pd.DataFrame(rows)\n",
    "metrics.round(4).to_csv(ROOT / \"results\" / \"tables\" / \"baseline_metrics.csv\", index=False)\n",
    "\n",
    "show = metrics[[\"model\", \"test set\", \"loans\", \"defaults\", \"actual %\", \"predicted %\", \"predicted / actual\", \"AUC\", \"AUC low\", \"AUC high\", \"Brier skill\", \"log loss\"]]\n",
    "show.round(3).set_index([\"model\", \"test set\"])"
   ]
  },
