    "            modified = True\n",
    "    if int(default) != truth.loc[loan, \"default_24m\"] or int(modified) != truth.loc[loan, \"modified_in_window\"]:\n",
    "        mismatch += 1\n",
    "print(f\"checked {len(rows)} loans, mismatches: {mismatch}\")"
