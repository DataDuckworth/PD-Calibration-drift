    "        rows.append({\"column\": col, \"code\": nan_code, \"loans with the code\": n,\n",
    "                     \"% of loans\": round(100 * n / len(o), 2)})\n",
    "pd.DataFrame(rows).set_index(\"column\")"
   ]
