    "# re-check the target for a sample of 2005 loans with simple loop logic\n",
    "import random\n",
    "random.seed(1)\n",
    "year = 2005\n",
    "ids = set(random.sample(list(table.loc[table[\"vintage\"] == year, \"loan_id\"]), 150))\n",
    "ids |= set(random.sample(list(table.loc[(table[\"vintage\"] == year) & (table[\"default_24m\"] == 1), \"loan_id\"]), 60))\n",
    "ids |= set(random.sample(list(table.loc[(table[\"vintage\"] == year) & (table[\"modified_in_window\"] == 1), \"loan_id\"]), 20))\n",
    "\n",
    "fo = pd.read_csv(RAW / f\"sample_orig_{year}.txt\", sep=\"|\", header=None, dtype=str, keep_default_na=False, usecols=[1, 19])\n",
    "first_pay = {r[19]: int(r[1][:4]) * 12 + int(r[1][4:6]) for _, r in fo[fo[19].isin(ids)].iterrows()}\n",
    "rows = {}\n",
    "for ch in pd.read_csv(RAW / f\"sample_perf_{year}.txt\", sep=\"|\", header=None, dtype=str, keep_default_na=False,\n",
    "                      usecols=[0, 1, 3, 7, 8], chunksize=1_000_000):\n",
    "    for r in ch[ch[0].isin(ids)].itertuples(index=False):\n",
